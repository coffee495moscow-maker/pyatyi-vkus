# --- Docker Compose (docker-compose.yml) ---
# These three set up the `db` service. docker-compose.yml builds
# DATABASE_URL from them automatically (pointing at the `db` service) — you
# don't need to set DATABASE_URL yourself when using Compose.
POSTGRES_USER=pyatyi_vkus
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=pyatyi_vkus

# Leave commented out to serve plain HTTP on the server's bare IP (see
# Caddyfile). Once you have a domain pointed at this server, uncomment and
# set it, and Caddy automatically provisions Let's Encrypt HTTPS for it.
# SITE_ADDRESS=example.com

# --- Database (only used if NOT running via Docker Compose) ---
# postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgres://pyatyi_vkus:changeme@localhost:5432/pyatyi_vkus

# Where uploaded product/promotion photos are stored on disk. Must be a
# persistent volume in production (docker-compose.yml already mounts one) —
# anything written here survives container restarts only if mounted.
UPLOAD_DIR=/data/uploads

# Payment provider — currently supports "yookassa"
PAYMENT_PROVIDER=yookassa
# ЮKassa personal cabinet → Settings → Shop credentials (https://yookassa.ru/my/)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Reserved for a future provider swap (see lib/payments/provider.ts):
# CLOUDPAYMENTS_PUBLIC_ID=
# CLOUDPAYMENTS_API_SECRET=

# Absolute site URL, used for payment return links and password-reset links.
# Set this to http://<your-server-ip> or https://<your-domain> in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP — optional. Without it, password-reset links are only logged to the
# server console (see lib/mail.ts) instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
