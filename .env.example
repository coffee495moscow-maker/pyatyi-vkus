# Supabase — Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the browser. Same page, "service_role" secret.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push — generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Store as a Supabase Edge Function secret (supabase secrets set), not as a Vercel env var.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:coffee495moscow@gmail.com

# Payment provider — currently supports "yookassa"
PAYMENT_PROVIDER=yookassa
# ЮKassa personal cabinet → Settings → Shop credentials (https://yookassa.ru/my/)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Reserved for a future provider swap (see lib/payments/provider.ts):
# CLOUDPAYMENTS_PUBLIC_ID=
# CLOUDPAYMENTS_API_SECRET=

# Absolute site URL, used for payment return links and push deep links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
